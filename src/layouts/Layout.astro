---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  /** Set on pages that shouldn't be indexed. Nothing uses it yet. */
  noindex?: boolean;
}

// Channel-neutral on purpose. Belpa ships two distribution routes — the embed,
// and the hosted /l/<slug> page with a QR code for roofers with no website,
// which is the dashboard's default install. This is the copy Google shows, so
// it must not tell a roofer without a website that the product isn't for them.
const {
  title = "Belpa: instant roof quotes for UK roofers",
  description =
    "Your customers get a price for their roof in seconds, worked out from satellite imagery. You get their details and the price they were shown. Use it on your website or hand out a link and QR code.",
  noindex = false,
} = Astro.props;

// Built off Astro.site (astro.config.mjs). Sub-pages are canonicalised WITHOUT
// a trailing slash and the root keeps its "/", which is exactly what the
// sitemap emits (see astro.config.mjs) and what vercel.json's trailingSlash
// redirect enforces. All three have to agree: /privacy and /privacy/ both
// return 200, so if they disagree the signal is split across two URLs Google
// treats as separate pages.
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonical = `${new URL(Astro.site!).origin}${path || "/"}`;
const ogImage = new URL("/og-image.jpg", Astro.site).href;
---

<!doctype html>
<!-- en-GB, not en: every price is in £, areas are m², and the product is sold
     to UK roofers only. The regional subtag is a relevance signal worth giving. -->
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Belpa" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Belpa" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data. Deliberately limited to things actually on the page
         and verifiable: no price (there's no pricing section to back it up),
         no aggregateRating, no sameAs, and no FAQPage — marking up Q&A that
         isn't visible on the page is a guidelines violation, and Google
         retired FAQ rich results for most sites anyway. Add FAQPage only if a
         real FAQ section ships. -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": `${Astro.site}#organization`,
            name: "Belpa",
            url: Astro.site?.href,
            logo: new URL("/icon-512.png", Astro.site).href,
            areaServed: { "@type": "Country", name: "United Kingdom" },
          },
          {
            "@type": "WebSite",
            "@id": `${Astro.site}#website`,
            url: Astro.site?.href,
            name: "Belpa",
            inLanguage: "en-GB",
            publisher: { "@id": `${Astro.site}#organization` },
          },
          {
            "@type": "SoftwareApplication",
            name: "Belpa",
            applicationCategory: "BusinessApplication",
            operatingSystem: "Web",
            url: Astro.site?.href,
            description:
              "Instant roof quotes for UK roofers. Customers get an indicative price for their roof in seconds, measured from satellite imagery, delivered through a widget on the roofer's website or a shareable link and QR code.",
            publisher: { "@id": `${Astro.site}#organization` },
          },
        ],
      })}
    />

    <!-- SVG first: browsers that support it get a mark that stays sharp at any
         size, with the PNGs as the fallback for those that don't. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f57f0" />
    <!-- The blob is the page visual anchor: fetch it before the CSS asks -->
    <link rel="preload" as="image" href="/bg-v3.webp" fetchpriority="high" />
    <!-- Header wordmark + the hero's aerial scan: both above the fold.
         This preloaded /roof-scan.webp until the hero was rebuilt around
         RoofScan.astro, which moved that image below the fold into
         DashboardDemo — so the browser was racing to fetch a below-fold image
         at high priority while the real LCP image queued behind it.
         srcset/sizes must stay identical to the <img> in RoofScan.astro,
         otherwise the preload fetches one file and the paint uses another. -->
    <link rel="preload" as="image" href="/belpa-wordmark.png" fetchpriority="high" />
    <link
      rel="preload"
      as="image"
      href="/satellite-roof.webp"
      imagesrcset="/satellite-roof-760.webp 760w, /satellite-roof.webp 1280w"
      imagesizes="(min-width: 1024px) 46vw, 92vw"
      fetchpriority="high"
    />
    <!--
      Kill scroll restoration before first paint. Otherwise refresh-on-hero
      restores a few px (or animates there) while fonts/morph shift layout.
    -->
    <script is:inline>
      // Marks that scripts run, BEFORE first paint. The header's own wordmark
      // is hidden off this, because the flying hero wordmark is going to dock
      // into that slot — waiting for brand-dock to set is-brand-morphing left a
      // visible window at load where both marks were on screen at once.
      // Without JS the class never lands and the header keeps its own wordmark.
      document.documentElement.classList.add("has-js");
      try {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      } catch (_) {}
      if (!location.hash) {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        // This block runs in <head>, so document.body is still null here —
        // assigning to it threw on every single page load and aborted the
        // rest of this script. documentElement is the scroller anyway.
        if (document.body) document.body.scrollTop = 0;
      }
    </script>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="site-dots" aria-hidden="true"></div>
    <slot />

    {/*
      Real Belpa widget embed goes here when it's ready, e.g.:
      <script src="https://cdn.belpa.app/embed.js" data-belpa="YOUR_SITE_KEY" defer></script>
      It replaces the placeholder demo in DemoSection.astro (#belpa-widget).
    */}

    <SpeedInsights />
  </body>
</html>

<script>
  // Scrolling is native. Lenis used to drive it with a 2.1s eased glide; it
  // was removed because people disliked it — a hijacked wheel fights muscle
  // memory, and the cost was not only taste. It read `wheel` off the document,
  // so a cross-origin iframe under the cursor starved it mid-glide and needed a
  // pointer-events workaround in LiveWidget; it owned the scroll position, so
  // every scroll-driven effect had to ask it rather than the window; and it
  // could not be stopped by CSS, so overlays had to call into it to lock.
  // All of that is gone with it.

  function pinTop() {
    window.scrollTo(0, 0);
    document.documentElement.scrollTop = 0;
    document.body.scrollTop = 0;
  }

  function initAnchorScroll() {
    if (document.documentElement.dataset.anchorScrollBound === "1") return;
    document.documentElement.dataset.anchorScrollBound = "1";

    // scrollIntoView with behavior:"smooth" is the native equivalent, and it
    // respects prefers-reduced-motion on its own — no media query needed.
    // scroll-margin-top on the targets supplies the offset the old
    // `{ offset: -24 }` did, so it lives in CSS with the layout it belongs to.
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement | null)?.closest?.<HTMLAnchorElement>(
        'a[href^="#"]',
      );
      if (!a || !a.hash || a.hash === "#") return;
      const target = document.querySelector(a.hash);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  // Hold the top through hero entrance layout shifts unless the user scrolls.
  function holdHeroTop() {
    if (location.hash) return;

    let userScrolled = false;
    const mark = () => {
      userScrolled = true;
    };
    window.addEventListener("wheel", mark, { passive: true, once: true });
    window.addEventListener("touchmove", mark, { passive: true, once: true });
    window.addEventListener("pointerdown", mark, { passive: true, once: true });
    window.addEventListener("keydown", (e) => {
      if (
        e.key === "ArrowDown" ||
        e.key === "ArrowUp" ||
        e.key === "PageDown" ||
        e.key === "PageUp" ||
        e.key === " " ||
        e.key === "Home" ||
        e.key === "End"
      ) {
        mark();
      }
    }, { passive: true, once: true });

    pinTop();

    const started = performance.now();
    const tick = () => {
      if (!userScrolled && !location.hash && window.scrollY > 40) {
        userScrolled = true;
      } else if (!userScrolled && !location.hash && window.scrollY > 0) {
        pinTop();
      }
      if (performance.now() - started < 3200) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    window.addEventListener(
      "pageshow",
      (e) => {
        // bfcache restore can bring back a mid-scroll offset
        if (e.persisted && !location.hash) pinTop();
      },
      { passive: true }
    );
  }

  initAnchorScroll();
  holdHeroTop();
  document.addEventListener("astro:after-swap", () => {
    initAnchorScroll();
    holdHeroTop();
  });
</script>

<script>
  /**
   * Mobile only: pin the hero blob behind the search + WhatsApp CTA cluster.
   * Hide until the first measure, then bloom from the correct place so the
   * user never sees a default→shift jump.
   */
  function initBlobAnchor() {
    const bg = document.querySelector<HTMLElement>(".site-bg");
    if (!bg) return;

    const mq = window.matchMedia("(max-width: 640px)");
    // Mask opaque band midpoint on the 1650px mobile layer:
    // ((32% + 48%) / 2) * 1650 + top(-90) ≈ 570px from document top at shift 0.
    const NATURAL_BAND_MID = -90 + 1650 * 0.4;

    const measureShift = (): number | null => {
      const widget = document.querySelector<HTMLElement>("[data-widget-shell]");
      if (!widget) return null;
      // Centre the glow on the widget. (This used to average the widget with
      // the hero's WhatsApp slab; that button is a quiet link above the
      // demo now, so it's no longer part of the cluster to sit behind.)
      const w = widget.getBoundingClientRect();
      return Math.round(w.top + w.height * 0.55 - NATURAL_BAND_MID);
    };

    const reveal = () => {
      // Force a style flush so the browser applies --blob-shift before bloom.
      void bg.offsetWidth;
      bg.classList.add("is-anchored");
    };

    const pinAndReveal = () => {
      if (!mq.matches) {
        bg.style.removeProperty("--blob-shift");
        bg.classList.add("is-anchored");
        return;
      }
      const shift = measureShift();
      if (shift == null) {
        // Widget not ready — try again next frame, still hidden.
        requestAnimationFrame(pinAndReveal);
        return;
      }
      bg.style.setProperty("--blob-shift", `${shift}px`);
      reveal();
    };

    // Quiet re-pin on orientation / width change only (no mid-bloom nudges).
    let lastW = window.innerWidth;
    const onResize = () => {
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      if (!mq.matches) {
        bg.style.removeProperty("--blob-shift");
        bg.classList.add("is-anchored");
        return;
      }
      const shift = measureShift();
      if (shift != null) bg.style.setProperty("--blob-shift", `${shift}px`);
    };

    // Double-rAF: layout has the centred hero before we measure.
    requestAnimationFrame(() => {
      requestAnimationFrame(pinAndReveal);
    });

    window.addEventListener("resize", onResize, { passive: true });
    mq.addEventListener("change", () => {
      bg.classList.remove("is-anchored");
      pinAndReveal();
    });

    document.addEventListener("astro:after-swap", () => {
      lastW = window.innerWidth;
      bg.classList.remove("is-anchored");
      requestAnimationFrame(() => {
        requestAnimationFrame(pinAndReveal);
      });
    });
  }

  initBlobAnchor();
</script>

<script>
  // Scroll-triggered reveals — transform/opacity only, one observer for the page.
  function initReveals() {
    const nodes = document.querySelectorAll<HTMLElement>("[data-reveal], [data-stagger]");
    if (!nodes.length) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      nodes.forEach((el) => el.classList.add("is-in"));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-in");
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
    );

    nodes.forEach((el) => {
      // Already visible on first paint (e.g. tall screens) — reveal immediately
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.9 && rect.bottom > 0) {
        // Stagger a frame so CSS transitions still fire
        requestAnimationFrame(() => el.classList.add("is-in"));
      } else {
        io.observe(el);
      }
    });
  }

  initReveals();
  document.addEventListener("astro:after-swap", initReveals);
</script>

<script>
  // Scroll-linked "cinematic" section effects (desktop). Composes with the
  // reveals above via the individual scale/translate/rotate properties.
  import { initSectionFx } from "../scripts/section-fx";

  let cleanupFx = initSectionFx();
  document.addEventListener("astro:after-swap", () => {
    cleanupFx?.();
    cleanupFx = initSectionFx();
  });
</script>
