---
/* WhatsApp rather than a calendar booking.
   Roofers are on a roof, in a van, or on someone's drive. Picking a
   fifteen-minute slot is a commitment and a wait; a message is neither, and it
   is already how the trade talks to each other. Same action the dashboard
   leads with on every lead, so the two halves of the product agree.

   wa.me wants the number in international form with no plus, no spaces and no
   leading zero: 07405043602 becomes 447405043602. The prefilled text saves the
   "what do I even say" pause and marks the enquiry as coming from the site. */
const whatsappNumber = "447405043602";
const whatsappMessage = "Hi Belpa, I saw your site and I'd like to know more.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
// Roofer login. Points at the dashboard root, which auto-routes: logged-out to
// /login, logged-in straight to /quotes. Env-overridable like the embed origin.
const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ?? "https://app.belpa.co.uk";
---

<!--
  A full-width header bar that is present from the top of the page, WITH the
  hero wordmark morphing into it on scroll.

  Two earlier versions each had half of this. The floating glass pill had the
  morph but nothing at the top of the fold, so the page opened with no nav and
  no way to log in. The plain sticky bar was always there but the morph had been
  retired to get it, so the big hero wordmark just scrolled away.

  Here the bar owns Log in and the WhatsApp CTA from the first frame, and its brand
  slot stays empty until the wordmark flies in and lands on it. That is why the
  bar does NOT carry data-glass-nav: that hook fades an element in as the
  wordmark arrives, which is right for a pill that shouldn't exist yet and wrong
  for a bar that has to be usable immediately.
-->

<!-- The flying wordmark. Fixed, driven entirely by brand-dock.ts through
     font-size + transform, so the img is sized in `em`. -->
<a href="/" class="brand-fly" data-brand-fly aria-label="Belpa home">
  <img src="/belpa-wordmark.png" alt="" width="900" height="279" />
</a>

<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <!-- The dock target. Layout-only: it reserves the space and gives
         brand-dock a rect to measure, and its own image stays hidden while the
         morph owns the visible wordmark. Same handoff the hero spacer uses. -->
    <a
      href="/"
      class="header-brand"
      data-nav-brand-slot
      aria-label="Belpa home"
    >
      <img src="/belpa-wordmark.png" alt="" width="900" height="279" />
    </a>

    <nav class="header-actions" aria-label="Main">
      <a href={dashboardUrl} class="header-login">Log in</a>
      <a
        href={whatsappUrl}
        class="header-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        {/* The WhatsApp glyph, filled rather than stroked like the calendar
            icon it replaces — it is a recognised mark, and outlining it makes
            it read as a generic speech bubble instead. */}
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.95 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.43-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c-.01 5.19-4.24 9.41-9.4 9.41zm8.02-17.43A11.28 11.28 0 0 0 12.04.75C5.8.75.72 5.83.72 12.07c0 1.99.52 3.94 1.51 5.66L.63 23.5l5.9-1.55a11.3 11.3 0 0 0 5.5 1.4h.01c6.24 0 11.32-5.08 11.32-11.32 0-3.03-1.18-5.87-3.3-8z"/>
        </svg>
        <span>WhatsApp us</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding: max(0.7rem, env(safe-area-inset-top, 0px)) 0 0.7rem;
    /* Glass only once scrolled — over the hero it's invisible chrome so the
       blob and the headline own the fold. */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      backdrop-filter 0.28s ease;
  }
  .site-header.is-stuck {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(22px) saturate(1.7);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    border-bottom-color: rgba(16, 24, 40, 0.07);
    box-shadow: 0 10px 30px -22px rgba(23, 60, 160, 0.5);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    /* 72rem matches the hero's max-w-6xl, and the inline padding matches its
       px-5 sm:px-6 — so the wordmark sits on the same left edge as the headline
       and the CTA on the same right edge as the content.
       These were clamp(1rem, 3vw, 1.75rem), which agreed with the hero at no
       width at all: 4px too far in on desktop and 4px too far out on mobile.
       If the hero's container padding changes, change it here too. */
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) {
    .site-header-inner {
      padding-inline: 1.5rem;
    }
  }

  /* font-size is the logo's size knob — the img is sized in em, and
     brand-dock.ts reads getComputedStyle(slot).fontSize to work out where the
     flight ends. Change the size here, never on the img. */
  .header-brand {
    display: block;
    flex: none;
    font-size: 26px;
    line-height: 0;
    text-decoration: none;
  }
  .header-brand img {
    display: block;
    height: 1em;
    width: auto;
  }
  /* Desktop: morph owns the visible mark — hide the slot img from first paint.
     Mobile: no scroll-linked flight (it jitters on touch momentum). Header mark
     fades in once the bar sticks; hero mark scrolls away. `has-js` is set in
     Layout.astro's <head>. */
  @media (min-width: 640px) {
    :global(html.has-js) .header-brand img {
      visibility: hidden;
    }
  }
  @media (max-width: 639px) {
    :global(html.has-js) .header-brand img {
      opacity: 0;
      transition: opacity 0.4s var(--ease-out-soft, cubic-bezier(0.22, 1, 0.36, 1));
    }
    :global(html.has-js) .site-header.is-stuck .header-brand img {
      opacity: 1;
    }
  }
  .header-brand:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 6px;
    border-radius: 4px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }

  /* Quiet utility for returning roofers — deliberately subordinate to the
     filled CTA so it never reads as a competing button. */
  .header-login {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .header-login:hover {
    color: var(--color-brand-600);
  }
  .header-login:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.68rem 1.15rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-600));
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 20px -8px rgba(31, 87, 240, 0.55);
    transition:
      filter 0.15s ease,
      box-shadow 0.2s ease;
  }
  .header-cta:hover {
    filter: brightness(1.05);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.32) inset,
      0 12px 26px -8px rgba(31, 87, 240, 0.6);
  }
  .header-cta:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 3px;
  }
  .header-cta svg {
    flex: none;
  }

  /* —— The flying wordmark (desktop morph only) —— */
  @media (max-width: 639px) {
    .brand-fly {
      display: none;
    }
  }
  .brand-fly {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    margin: 0;
    padding: 0;
    border: 0;
    line-height: 0;
    white-space: nowrap;
    text-decoration: none;
    transform-origin: 0 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .brand-fly img {
    display: block;
    height: 1em;
    width: auto;
  }
  .brand-fly.is-ready {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  /* Solid wordmark always. A highlight sweeps through the logo's shape while
     it's resting in the hero — the mark itself never slides away. */
  .brand-fly.is-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(91, 140, 255, 0.9) 50%,
      transparent 58%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    background-position: 200% 50%;
    -webkit-mask-image: url("/belpa-wordmark.png");
    mask-image: url("/belpa-wordmark.png");
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: brand-sheen 9s linear infinite;
  }
  .brand-fly:not(.is-hero)::after {
    content: none;
    animation: none;
  }
  @keyframes brand-sheen {
    0% { background-position: 200% 50%; }
    32% { background-position: -200% 50%; }
    100% { background-position: -200% 50%; }
  }

  @media (max-width: 480px) {
    .header-brand {
      font-size: 22px;
    }
    .header-cta {
      padding: 0.6rem 0.95rem;
      font-size: 0.85rem;
    }
    .header-cta svg {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
    .brand-fly.is-hero::after {
      content: none;
      animation: none;
    }
  }
</style>

<script>
  import { initBrandDock } from "../scripts/brand-dock";

  let cleanup: (() => void) | null = null;

  // Threshold toggle, not a scroll-linked morph: crossing the line flips a
  // class and CSS runs a fixed-duration transition, so it stays smooth however
  // fast you scroll. Hysteresis on the two edges stops it flickering.
  function initHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;
    let stuck = false;
    let raf = 0;

    const evaluate = () => {
      raf = 0;
      const y = window.scrollY;
      if (!stuck && y > 24) {
        stuck = true;
        header.classList.add("is-stuck");
      } else if (stuck && y < 8) {
        stuck = false;
        header.classList.remove("is-stuck");
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(evaluate);
    };

    evaluate();
    window.addEventListener("scroll", onScroll, { passive: true });

    cleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      window.removeEventListener("scroll", onScroll);
    };
  }

  // Scroll-linked morph is desktop-only. On touch, momentum scrolling and
  // per-frame transforms fight each other and read as jitter — phones get a
  // CSS fade of the header mark when the bar sticks instead.
  const DESKTOP = "(min-width: 640px)";

  function boot() {
    initHeader();
    if (window.matchMedia(DESKTOP).matches) initBrandDock();
  }

  boot();
  document.addEventListener("astro:after-swap", () => {
    cleanup?.();
    cleanup = null;
    boot();
  });
</script>
