---
import CloudPanel from "./CloudPanel.astro";

// The "why this matters" section. Deliberately built on published UK figures
// rather than invented ones: this page sells to trades who will know instantly
// if a number is made up, and the product's whole pitch is that its estimates
// are honest about what they are.
//
// Two caveats kept on the record so nobody re-uses these numbers wrongly:
//   * They are ALL-TRADES UK figures. Nothing roofing-specific exists for
//     quoting time, so the copy says "UK trades", never "roofers".
//   * The 5h20m and 20-minute figures come from vendor-run surveys (quoting
//     software companies), so they have an interest in the answer. Real
//     research, but not independent.
//
// Kept deliberately light. An earlier pass had a heading, three cards each with
// a diagram and a paragraph, a SECOND heading, a separate row of answers and a
// footnote block — seven blocks for three ideas, and the problem/answer split
// across two rows made you cross-reference to get the payoff. Each card now
// carries its own figure, problem and fix, so one glance down a card is the
// whole argument. Resist re-adding supporting paragraphs: the number is the
// point, and anything it needs explained belongs in the source, not the card.
//
// Copy discipline. WRITE PLAIN COMPLETE SENTENCES. This copy was rewritten
// four times and every rewrite that made it shorter made it worse, because
// compression reads as cryptic: "a week quoting, after you're already off the
// roof" is a fragment the reader has to reassemble before it means anything.
// Terseness is not clarity. A roofer landing here should be able to answer
// "is this for me?" and "what changes for me?" without decoding a single line.
//   * `label` REFERS BACK to the figure, it does not continue it. Opening with
//     "That's what…/That's how long…/That's how many…" is the whole trick.
//     Earlier versions read "5h 20m" + "a week on quoting and admin", which is
//     one phrase split across two visual blocks — the sentence breaks over the
//     gap and lands as a non-sequitur. The label must carry its own unit
//     ("every week", "one quote") and stand up as a sentence on its own.
//   * `fix` says what WE do about it, also as a full sentence, naming a real
//     mechanic — satellite measurement, the price, where the lead lands.
//
// Short is fine; SHORTENED is not. Cut whole clauses that repeat something the
// reader already has, and keep every sentence a sentence. What broke it before
// was squeezing sentences into fragments to save words, which left the reader
// doing the assembly. Never trade a concrete noun (satellite imagery, postcode,
// their number) for a shorter vague one.
//
// `fix` is a CLAIM about the product, not a sourced figure — that's why only
// `label` carries a footnote marker. Belpa returns an indicative ex-VAT range
// and the roofer still prices the job on site, so no fix may imply Belpa does
// the quoting outright. Every mechanic named above is real: satellite
// measurement via the Solar envelope or a traced outline, access uplifts from
// pitch and property type, per-roofer rates from roofer_pricing, and the lead
// row carrying contact phone and postcode.
const stats = [
  {
    figure: "5h 20m",
    label:
      "That's what the average UK trade spends on quoting and admin every week. 77% of it after hours.",
    src: "1",
    fix: "We price the job the moment a customer asks. Your evening stays free.",
  },
  {
    figure: "20 min",
    label:
      "That's how long one quote takes to write. At 6–10 a week, most of it never becomes paid work.",
    src: "2",
    fix: "We measure the roof from satellite imagery and price it. You write nothing.",
  },
  {
    figure: "1 in 5",
    label:
      "That's how many customers drop the job completely, because they couldn't find anyone they trusted.",
    src: "3",
    fix: "We give them a price in seconds and send you their number and postcode.",
  },
];

const sources = [
  {
    n: "1",
    short: "PHAM News",
    href: "https://phamnews.co.uk/nine-in-ten-tradespeople-stressed-by-running-their-business-survey-finds/",
  },
  {
    n: "2",
    short: "Use CMA",
    href: "https://usecma.com/blog/quoting-software-for-uk-tradespeople-what-to-look-for-in-2026",
  },
  {
    n: "3",
    short: "FMB survey",
    href: "http://www.buildersmerchantsnews.co.uk/news/fullstory.php/aid/11604/Anxious_consumers_avoid__A36bn_of_building_work,_FMB_survey_suggests.html",
  },
];
---

<section id="numbers" class="qc relative w-full pt-6 pb-16 sm:pt-12 sm:pb-28">
  <CloudPanel />

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
    <div class="qc-inner px-2 py-12 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <h2 class="font-display qc-heading">
          Three problems with quoting, and what we do about them.
        </h2>
      </div>

      <div class="qc-grid mt-10 sm:mt-14">
        {stats.map((s, i) => (
          <div class="qc-card" data-reveal="fade" data-delay={String(i + 1)}>
            <p class="qc-figure font-display">
              {s.figure}<sup class="qc-sup">{s.src}</sup>
            </p>
            <p class="qc-label">{s.label}</p>

            <p class="qc-fix">
              <svg class="qc-tick" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10.5 L8.2 14.4 L16 5.8" />
              </svg>
              <span>{s.fix}</span>
            </p>
          </div>
        ))}
      </div>

      <p class="qc-sources" data-reveal="fade" data-delay="4">
        {sources.map((s, i) => (
          <>
            {i > 0 && <span class="qc-dot" aria-hidden="true">·</span>}
            <a href={s.href} target="_blank" rel="noopener noreferrer nofollow">
              <sup>{s.n}</sup>{s.short}
            </a>
          </>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .qc {
    /* The cloud panel bleeds past this box on every side; nothing here may clip
       it or the soft mask edges turn into hard lines. */
    overflow: visible;
  }
  .qc-inner {
    position: relative;
  }

  /* Says exactly what the section contains. It replaced "You don't get paid to
     quote." — a better line, but you had to read the cards to work out what
     the section actually was. A heading's job here is to orient, not to hook. */
  .qc-heading {
    margin: 0;
    max-width: 20em;
    margin-inline: auto;
    font-size: clamp(1.7rem, 3.9vw, 2.6rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #fff;
    /* Clouds drift underneath and can get bright — the shadow is what keeps
       white type legible over them at every frame. */
    text-shadow:
      0 1px 2px rgba(5, 20, 70, 0.55),
      0 2px 14px rgba(5, 20, 70, 0.7),
      0 8px 36px rgba(5, 20, 70, 0.85);
  }
  @media (max-width: 640px) {
    .qc-heading { font-size: clamp(1.5rem, 7vw, 2rem); }
  }

  .qc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .qc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* Solid white, not glass. The section already animates `filter` on entrance
     and global.css documents that a backdrop-filter child snaps the compositor
     when those keyframes finish — and against a moving cloudscape a flat card
     is the only way small type stays readable frame to frame. */
  .qc-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1.5rem;
    border-radius: 20px;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow:
      0 0 0 1px rgba(21, 55, 140, 0.14),
      0 24px 48px -22px rgba(10, 32, 90, 0.55);
  }

  .qc-figure {
    margin: 0;
    font-size: clamp(2.3rem, 4.6vw, 3.1rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-brand-600, var(--color-brand-500));
  }
  .qc-sup {
    margin-left: 0.15em;
    font-size: 0.3em;
    font-weight: 600;
    vertical-align: super;
    letter-spacing: 0;
    color: var(--color-ink-soft);
    opacity: 0.7;
  }

  /* Runs to two or three lines now that it describes the moment rather than
     the statistic, so it needs more leading than a one-line label did.
     Reserves three lines so the ticks below line up across the row whatever
     the copy does — tuning sentence lengths to match held only at one exact
     viewport width and broke the moment anything rewrapped. */
  .qc-label {
    margin: 0.65rem 0 0;
    min-height: calc(3 * 1.45em);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.45;
    color: var(--color-ink);
  }
  @media (max-width: 767px) {
    /* Stacked, so there's nothing to align with and the reserved space would
       just be a gap under every card. */
    .qc-label { min-height: 0; }
  }

  /* Top-aligned, not pinned to the card bottom. Bottom-pinning made the
     single-line fix drop below the two-line ones, which read as broken —
     the labels are all one line, so starting them together lines them up. */
  .qc-fix {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding-top: 1.1rem;
    font-size: 0.93rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
  }
  .qc-tick {
    flex: none;
    width: 17px;
    height: 17px;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--color-brand-500);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* One quiet line. The figures are real and stay attributable, but the
     citation must not become a seventh block competing with them. */
  .qc-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: clamp(1.5rem, 3vw, 2.25rem) auto 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    text-shadow: 0 1px 6px rgba(5, 20, 70, 0.85);
  }
  .qc-sources a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }
  .qc-sources a:hover {
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.8);
  }
  .qc-sources sup {
    margin-right: 0.25em;
    font-weight: 700;
  }
  .qc-dot {
    opacity: 0.5;
  }
</style>
